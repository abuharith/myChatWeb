# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000

# ── Postgres ───────────────────────────────────────────────
DATABASE_URL=postgresql://voidlink:voidlink@localhost:5432/voidlink?schema=public

# ── Redis (presence, typing, pub/sub, rate limits) ─────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-64-random-bytes
JWT_REFRESH_SECRET=replace-with-another-64-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ARGON2_MEMORY_KIB=65536
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ── Email (console in dev, resend/ses in production) ───────
EMAIL_TRANSPORT=console
EMAIL_FROM="VoidLink <no-reply@voidlink.app>"
RESEND_API_KEY=

# ── Object storage (S3 compatible: MinIO dev / R2 prod) ────
S3_ENDPOINT=http://localhost:9000
# Host embedded in presigned PUT URLs; must be reachable by the browser.
# Leave equal to S3_ENDPOINT when the storage endpoint itself is public (R2).
S3_PUBLIC_ENDPOINT=http://localhost:3000/s3
S3_REGION=auto
S3_BUCKET=voidlink-media
S3_ACCESS_KEY_ID=voidlink
S3_SECRET_ACCESS_KEY=voidlink-secret
S3_FORCE_PATH_STYLE=true
# Development only: run an in-process S3 API instead of MinIO.
S3_EMBEDDED=false
UPLOAD_URL_TTL_SECONDS=900
MEDIA_URL_TTL_SECONDS=3600
MEDIA_SIGNING_SECRET=replace-with-32-random-bytes

# ── WebRTC / TURN ──────────────────────────────────────────
TURN_URL=turn:localhost:3478
TURN_SECRET=replace-with-coturn-static-auth-secret
TURN_CREDENTIAL_TTL=3600
STUN_URLS=stun:stun.l.google.com:19302
# Group calls (SFU) — leave blank to run 1-to-1 P2P only
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Media processing ───────────────────────────────────────
# Limits live in packages/shared (images 15 MB, video 100 MB, audio/voice 25 MB,
# files 25 MB). Images are re-encoded and capped at 2048px; EXIF is stripped.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CALL_PARTICIPANTS=8
VIRUS_SCAN_CMD=               # reserved: clean status is recorded when processing succeeds

# ── Web Push ───────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@voidlink.app

# ── Web (Vite, exposed to the client) ──────────────────────
VITE_API_URL=http://localhost:4000/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_TURN_URL=turn:localhost:3478
